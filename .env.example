# Copiez ce fichier vers .env.local et renseignez les valeurs de Supabase.
# Utilisez uniquement la clé publique anon/publishable dans le frontend.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Domaine canonique public, sans slash final (ex. https://sahaba.example)
VITE_SITE_URL=https://YOUR_PUBLIC_DOMAIN
